# Django
DJANGO_ENV=dev
# Сгенерируйте свой: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# ВНИМАНИЕ: на этой машине порты 5432 и 5433 занимают другие проекты,
# поэтому музейный Postgres проброшен на 5440 (см. README).
# Если порт тоже занят — выберите свободный и поправьте здесь и в docker run.
POSTGRES_DB=museum
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum_dev_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440

# Почта (в dev письма печатаются в консоль)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=museum@example.com

# Продакшен: список доменов через запятую (используется только в prod.py)
# ALLOWED_HOSTS=museum.example.com,www.museum.example.com
# CSRF_TRUSTED_ORIGINS=https://museum.example.com,https://www.museum.example.com
